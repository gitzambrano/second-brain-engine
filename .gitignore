__pycache__/
*.code-workspace
.miktex/

# .claude/skills/ e .claude/agents/ são espelhos gerados de .agents/ por
# scripts/sync_skills.py, e derivado não se versiona. O resto de .claude/ é
# estado local do harness (settings.local.json, locks, worktrees). Só
# settings.json entra no repositório, porque é o bootstrap do próprio sync.
# Os adaptadores do Codex em .codex/agents/*.toml são versionados: são outro
# formato, não cópia byte a byte, e não saem de sync_skills.py.
.claude/*
!.claude/settings.json

# The two nested repositories are intentionally invisible to the outer engine Git.
/data/
/site/

# Legacy personal-data locations must never be reintroduced into the public engine.
/wiki/
/plan/
/raw/
/output/
/.obsidian/

# Local semantic-search caches
.qmd-cache/
.qmd-config/
.qmd-output/

# Python/test tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
playwright-report/
test-results/

# OS/editor
.DS_Store
Thumbs.db

# Migration handoff package (local only)
/second-brain-new-framework.zip

# Saída de teste com --basetemp (capturas do job site-browser).
/artifacts/

# Anexos locais do Codex; não fazem parte do engine nem da wiki.
/.codex-remote-attachments/

# Rascunho de diagnóstico na raiz (_count.py, _pytest2.txt e afins). Já foram
# commitados em main uma vez, um deles carregando caminho C:\Users\ da máquina
# local. A raiz do engine é allowlist: só entra arquivo listado no teste
# tests/test_repo_layout.py, e nada com prefixo `_`.
/_*

# Rascunho de investigação (diffs, XHTML intermediário, PNG de revisão de
# paginação). Já entrou em `main` uma vez por um `git add -A`: 81 arquivos e
# alguns MB de PNG num repositório que não guarda corpus.
/tmp/
.worktrees/
